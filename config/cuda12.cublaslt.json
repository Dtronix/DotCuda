{
  // cuBLASLt (cublasLt.h). Shared types it needs from cublas_api.h and library_types.h (cublasStatus_t,
  // cublasComputeType_t, cudaDataType_t, ...) are emitted here because a cuBLASLt function uses them;
  // cudaStream_t is struct CUstream_st*, reused from the driver package as CUstream.
  "name": "CublasLt",
  "project": "DotCuda.Cuda12.CublasLt",
  "className": "CublasLt",
  "header": "cublasLt.h",
  // CUDA 12 headers: DOTCUDA_CUDA12_PATH, else the newest installed v12.x toolkit (never CUDA_PATH, which may be 13).
  "includeDirs": ["%DOTCUDA_CUDA12_PATH%\\include", "%ProgramFiles%\\NVIDIA GPU Computing Toolkit\\CUDA\\v12.*\\include"],
  "functionPrefixes": ["cublasLt"],
  "typePrefixes": ["cublasLt", "CUBLASLT"],
  "constantPrefixes": ["CUBLASLT"],
  "references": ["Driver"],
  // Descriptors are pointers to semi-opaque structs (uint64_t data[N]) created by cublasLt*Create; bind them as handles.
  "pointerHandles": ["cublasLtMatrixLayout_t", "cublasLtMatmulDesc_t", "cublasLtMatrixTransformDesc_t", "cublasLtMatmulPreference_t"],
  // Attribute value types named in cublasLt.h's attribute docs but used by no signature.
  "extraTypes": ["cublasOperation_t", "cublasFillMode_t"],
  "excludeFunctions": {
    "cublasLtDisableCpuInstructionsSetMask": "declared in cublasLt.h but not exported by cublasLt64_12.dll (12.6 or 12.8)"
  },
  "versionMacros": ["CUBLAS_VER_MAJOR", "CUBLAS_VER_MINOR", "CUBLAS_VER_PATCH", "CUBLAS_VER_BUILD"],
  "library": {
    "logicalName": "cublasLt",
    "windows": "cublasLt64_12.dll",
    "linux": "libcublasLt.so.12"
  }
}
