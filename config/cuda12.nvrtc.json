{
  // NVRTC runtime compilation (nvrtc.h).
  "name": "Nvrtc",
  "project": "DotCuda.Cuda12.Nvrtc",
  "className": "Nvrtc",
  "header": "nvrtc.h",
  // CUDA 12 headers: DOTCUDA_CUDA12_PATH, else the newest installed v12.x toolkit (never CUDA_PATH, which may be 13).
  "includeDirs": ["%DOTCUDA_CUDA12_PATH%\\include", "%ProgramFiles%\\NVIDIA GPU Computing Toolkit\\CUDA\\v12.*\\include"],
  "functionPrefixes": ["nvrtc"],
  "typePrefixes": ["nvrtc"],
  "constantPrefixes": ["NVRTC"],
  "library": {
    "logicalName": "nvrtc",
    "windows": "nvrtc64_120_0.dll",
    "linux": "libnvrtc.so.12",
    // NVRTC loads its builtins library by bare name when compiling; its file name carries the minor version.
    "windowsPreload": ["nvrtc-builtins64_12*.dll"],
    "linuxPreload": ["libnvrtc-builtins.so.12*"]
  }
}
