{
  // NVML, the NVIDIA Management Library (nvml.h): device inventory, utilization, memory, clocks, temperature, power.
  // The library ships with the driver, not the toolkit, so like the driver it is never taken from DOTCUDA_LIB_DIR.
  "name": "Nvml13",
  "project": "DotCuda.Cuda13.Nvml",
  "namespace": "DotCuda.Cuda13",
  "className": "Nvml",
  "header": "nvml.h",
  // CUDA 13 headers: DOTCUDA_CUDA13_PATH, else tools/fetch-cuda-sdk.ps1's folder, else an installed v13.x toolkit.
  "includeDirs": ["%DOTCUDA_CUDA13_PATH%\\include", "%LOCALAPPDATA%\\DotCuda\\sdk\\cuda-13.*\\include", "%ProgramFiles%\\NVIDIA GPU Computing Toolkit\\CUDA\\v13.*\\include"],
  "functionPrefixes": ["nvml"],
  "typePrefixes": ["nvml"],
  "constantPrefixes": ["NVML"],
  "versionMacros": ["NVML_API_VERSION"],
  // NVML ships with the driver, so the newest header can declare functions an older driver lacks.
  "excludeFunctions": {
    "nvmlDeviceGetBBXTimeData_v1":"declared in the CUDA 13.4 nvml.h but not exported by nvml.dll of driver 617.14; remove once drivers export it"
  },
  "library": {
    "logicalName": "nvml",
    "windows": "nvml.dll",
    "linux": "libnvidia-ml.so.1",
    "useLibDir": false
  },
  "exportCheck": ["%SystemRoot%\\System32\\nvml.dll"]
}
