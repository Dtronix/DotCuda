<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="Generated\Package.g.props" />

  <PropertyGroup>
    <RootNamespace>DotCuda.Cuda12</RootNamespace>
    <Description>Pointer-only [LibraryImport] bindings for the CUDA 12 NVRTC (nvrtc.h), generated from NVIDIA's headers (version $(DotCudaHeaderVersion)).</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Generated members from header comments are documented where the header documents them. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DotCuda.Core\DotCuda.Core.csproj" />
    <None Include="Generated\SKIPPED.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
