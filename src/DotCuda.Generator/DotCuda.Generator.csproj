<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Dev-time tool: libclang native runtime is Windows x64 only for now. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ClangSharp" Version="21.1.8.4" />
    <PackageReference Include="libclang.runtime.win-x64" Version="21.1.8" />
    <PackageReference Include="libClangSharp.runtime.win-x64" Version="21.1.8.2" />
  </ItemGroup>

</Project>
